# Copy to .env (same folder) and fill in. .env is never committed.

# --- TigerGraph Savanna ---
TG_TGCLOUD=true
TG_HOST=https://YOUR-WORKSPACE.i.tgcloud.io
TG_GRAPHNAME=FraudGraph
# Database secret (the only TigerGraph credential the code reads)
TG_SECRET=

# --- Free LLM (OpenAI-compatible endpoint) ---
# Gemini (AI Studio key): https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
# Groq free tier, used automatically for chat when the Gemini quota runs out
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
